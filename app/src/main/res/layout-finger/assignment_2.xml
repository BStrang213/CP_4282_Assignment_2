<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MissingDefaultResource">

    <TextView
        android:id="@+id/textView5"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:text="" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:text="This is the dice game!"
        android:textSize="18sp"
        android:fontFamily="sans-serif"/>

    <EditText
        android:id="@+id/player1Name"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:ems="10"
        android:inputType="text"
        android:text="Please enter player one's name(Delete this first)"
        android:textSize="18sp"
        android:fontFamily="sans-serif"/>

    <EditText
        android:id="@+id/player2Name"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:ems="10"
        android:inputType="text"
        android:text="Please enter player two's name(Delete this first)"
        android:textSize="18sp"
        android:fontFamily="sans-serif"/>

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:text="Needed score to win is 96"
        android:textSize="18sp"
        android:fontFamily="sans-serif"/>

    <TextView
        android:id="@+id/textView3"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:text="press the button to roll the dice"
        android:textSize="18sp"
        android:fontFamily="sans-serif"/>

    <Button
        android:id="@+id/button"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:text="Roll the dice"
        android:fontFamily="sans-serif"/>

    <TextView
        android:id="@+id/diceValue"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:text="Dice value"
        android:textSize="18sp"
        android:fontFamily="sans-serif"/>

    <TextView
        android:id="@+id/player1Total"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:text="Player One's Value:"
        android:textSize="18sp"
        android:fontFamily="sans-serif"/>

    <TextView
        android:id="@+id/player2Total"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:text="Player Two's Value:"
        android:textSize="18sp"
        android:fontFamily="sans-serif"/>

    <TextView
        android:id="@+id/win"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:text="Results!!!"
        android:textSize="18sp"
        android:fontFamily="sans-serif"/>

</LinearLayout>